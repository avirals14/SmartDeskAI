# Copy this file to .env and fill in your values

PORT=4000

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=smartdesk
PG_PASSWORD=smartdesk_pass
PG_DATABASE=smartdesk

# MongoDB
MONGO_URI=mongodb://localhost:27017/smartdesk

# Redis
REDIS_URL=redis://localhost:6379

# Groq API key (get one at https://console.groq.com/keys)
# If you don't have a key, the AI service falls back to a rule-based
# mock classifier so the app still runs end-to-end for your demo.
GROQ_API_KEY=

# JWT signing secret — change this to a long random string before any real deployment.
JWT_SECRET=dev-secret-change-me